# Copy to .env and adjust. Matches docker-compose.yml.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://upvc:upvc@localhost:5432/upvc?schema=public"
# NOTE: if DATABASE_URL points at a transaction-mode pooler (PgBouncer, often on
# port 5433), append "&pgbouncer=true". The catalog seed avoids interactive
# transactions, so `npm run db:seed` works through a pooler either way.

# HTTP port for the API server (optional; defaults to 3005).
PORT=3005

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="12h"

# Seeded admin user (only created if no users exist)
ADMIN_EMAIL="admin@local"
ADMIN_PASSWORD="admin123"

# Object storage for generated PDFs + the company logo (M4). Matches the
# `minio` service in docker-compose.yml. For real AWS S3 / DO Spaces, set the
# endpoint to the provider's URL (or leave MINIO_ENDPOINT blank for AWS) and
# supply the bucket's access/secret keys.
MINIO_ENDPOINT="http://localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="upvc"
MINIO_REGION="us-east-1"
MINIO_FORCE_PATH_STYLE="true"
