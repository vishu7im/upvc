{
  "name": "upvc-saas-engine",
  "version": "0.1.0",
  "description": "uPVC window & door fabrication engine — calculations, cutting list, BOM, pricing. Sunny Plast 70mm calibrated against real Quotila outputs.",
  "type": "module",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "start": "tsx src/api/server.ts",
    "dev": "tsx watch src/api/server.ts",
    "validate": "tsx src/validation/jobs.ts",
    "validate:rbac": "tsx src/validation/rbac.api.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "import:prices": "tsx src/tools/import-prices.ts",
    "sync:permissions": "tsx src/tools/sync-permissions.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@prisma/client": "^5.22.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "bcryptjs": "^3.0.3",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "puppeteer": "^25.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "prisma": "^5.22.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
