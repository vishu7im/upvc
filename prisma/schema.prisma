// =====================================================================
// Prisma schema — persistence for the fabrication catalog.
//
// This mirrors the in-memory `ProfileSystem` / `Design` / `Settings`
// shapes in src/types.ts. The nested `Record<string, ...>` maps are
// modelled as relational tables keyed by their record key (`*Key`)
// so src/catalog/loader.ts can rebuild the EXACT in-memory objects the
// engine expects.
//
// Money/measurement columns are Decimal in the DB; the loader converts
// them to JS numbers so engine math stays byte-identical to the
// hardcoded catalog (132 validation assertions must still pass).
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Discriminator for the unified profile-part table ----------------
enum PartKind {
  FRAME
  SASH
  TRANSOM
  BEAD
  REINFORCEMENT
  AUXILIARY
}

// ---- A profile system (e.g. "sunnyplast-70") -------------------------
model ProfileSystem {
  id               String @id // = systemId, e.g. "sunnyplast-70"
  name             String
  currency         String
  stockBarLengthMm Int
  sawKerfMm        Int

  // Colour/finish currently applied for pricing (M5). null ⇒ no uplift.
  // Per-quote colour selection is deferred to the configurator UI (Phase 2);
  // for now this is the system-wide default (e.g. base "white", 0% uplift).
  defaultColourKey String?

  parts            ProfilePart[]
  glass            Glass[]
  gaskets          Gasket[]
  hardware         Hardware[]
  colours          ColourOption[]
  cills            Cill[]
  reinforcementMap ReinforcementMapEntry[]

  @@map("profile_system")
}

// ---- Frames, sashes, transoms, beads, reinforcement ------------------
// They share the ProfileSection base; specialised fields are nullable
// and only populated for the relevant kind.
model ProfilePart {
  id       String        @id @default(uuid())
  systemId String
  system   ProfileSystem @relation(fields: [systemId], references: [id], onDelete: Cascade)

  partKey String // the in-memory Record key, e.g. "frame-5ch"
  kind    PartKind

  // ProfileSection base
  code              String
  name              String
  faceWidth         Decimal @db.Decimal(10, 4)
  // Welding shrinkage allowance per welded end (mm). @default(0) keeps the
  // additive migration safe on existing rows and engine output byte-identical
  // until an admin edits it. See src/types.ts ProfileSection.weldAllowanceMm.
  weldAllowanceMm   Decimal @default(0) @db.Decimal(10, 4)
  cost              Decimal @db.Decimal(12, 4)
  price             Decimal @db.Decimal(12, 4)
  per               String // "m" | "pc" | "m2" | "set"
  weight            Decimal @db.Decimal(12, 4)
  financialCategory String

  // FrameSection / SashSection
  glassRebate  Decimal? @db.Decimal(10, 4)
  // SashSection
  overlap      Decimal? @db.Decimal(10, 4)
  // BeadSection
  stickOut     Decimal? @db.Decimal(10, 4)
  // TransomSection: "T" | "Z"
  jointType    String?
  // Reinforcement
  endClearance Decimal? @db.Decimal(10, 4)

  // Per-profile colour-tier prices (supplier price lists, M5.5). The supplier
  // lists visible profiles in three absolute price tiers — White (the `cost`/
  // `price` columns above), "1P Colour 1P White" (foil one side) and "2P Colour"
  // (foil both sides). These hold the 1P/2P £-per-unit; NULL ⇒ no tier price
  // known, so pricing falls back to base × the colour's %-uplift. A default
  // (White) quote never reads them ⇒ byte-identical. Only colour-bearing parts
  // (frame/sash/transom/bead) use them; reinforcement/aux stay tierless.
  cost1p  Decimal? @db.Decimal(12, 4)
  price1p Decimal? @db.Decimal(12, 4)
  cost2p  Decimal? @db.Decimal(12, 4)
  price2p Decimal? @db.Decimal(12, 4)

  @@unique([systemId, kind, partKey])
  @@map("profile_part")
}

// =====================================================================
// Supplier price-list provenance (M5.5) — the audit layer.
//
// Every price extracted from a supplier PDF is recorded here VERBATIM with
// its source document + effective date + unit + colour tier, then (optionally)
// mapped onto a catalog runtime row. The catalog cost/price columns stay the
// engine's read model; these tables are the reviewable history of where each
// number came from. Written by `npm run import:prices` from the transcribed
// data files in src/catalog/price-lists/*.
// =====================================================================
model Supplier {
  id        String          @id @default(uuid())
  key       String          @unique // e.g. "sunny-plast"
  name      String
  documents PriceDocument[]

  @@map("supplier")
}

model PriceDocument {
  id         String   @id @default(uuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  docKey        String   @unique // stable key, e.g. "sp-profiles-anglia-2025-04-25"
  sourceFile    String // exact PDF filename in docs/price_list/
  effectiveDate DateTime
  currency      String // "GBP"
  priceBasis    String? // e.g. "engross nett £/m, 6m lengths, 3 colour tiers"
  notes         String?
  importedAt    DateTime @default(now())

  items PriceItem[]

  @@map("price_document")
}

model PriceItem {
  id         String        @id @default(uuid())
  documentId String
  document   PriceDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  supplierCode String // VERBATIM from the PDF ("" when the row carries no code)
  description  String // verbatim
  unit         String // "m" | "m2" | "pc" | "lm" | "length" | "sheet"
  colourTier   String? // "white" | "1p" | "2p" | null (tierless)
  variant      String? // Doc B volume tier: "lorry" | "company" | "normal"
  packQty      Int? // e.g. GLIS 04 Bump Stop = 2
  stockLengthM Decimal? @db.Decimal(10, 4) // 6 / 4.2 where the PDF states it
  unitPrice    Decimal  @db.Decimal(12, 4) // nett GBP per `unit`
  source       String // per-line citation ("Doc A row 'Window Frame 70mm 5ch', White")

  // Mapping outcome, written by the import script (null ⇒ recorded-only/unmapped).
  mappedTable   String? // "profile_part" | "glass" | "cill" | "hardware" | "auxiliary"
  mappedKind    String? // PartKind when profile_part
  mappedPartKey String?
  applyNote     String? // decision note: alias, derivation, or why unmapped

  @@index([documentId])
  @@map("price_item")
}

// ---- Glass -----------------------------------------------------------
model Glass {
  id       String        @id @default(uuid())
  systemId String
  system   ProfileSystem @relation(fields: [systemId], references: [id], onDelete: Cascade)

  partKey           String
  code              String
  name              String
  rebatePerSide     Decimal @db.Decimal(10, 4)
  cost              Decimal @db.Decimal(12, 4)
  price             Decimal @db.Decimal(12, 4)
  per               String // "m2"
  weight            Decimal @db.Decimal(12, 4)
  financialCategory String

  @@unique([systemId, partKey])
  @@map("glass")
}

// ---- Gaskets ---------------------------------------------------------
model Gasket {
  id       String        @id @default(uuid())
  systemId String
  system   ProfileSystem @relation(fields: [systemId], references: [id], onDelete: Cascade)

  partKey           String
  code              String
  name              String
  cost              Decimal @db.Decimal(12, 4)
  price             Decimal @db.Decimal(12, 4)
  per               String // "m"
  weight            Decimal @db.Decimal(12, 4)
  financialCategory String

  @@unique([systemId, partKey])
  @@map("gasket")
}

// ---- Hardware --------------------------------------------------------
model Hardware {
  id       String        @id @default(uuid())
  systemId String
  system   ProfileSystem @relation(fields: [systemId], references: [id], onDelete: Cascade)

  partKey           String
  code              String
  name              String
  cost              Decimal  @db.Decimal(12, 4)
  price             Decimal  @db.Decimal(12, 4)
  per               String // "pc"
  weight            Decimal  @db.Decimal(12, 4)
  financialCategory String
  lengthMm          Decimal? @db.Decimal(10, 4) // espagnolettes / friction hinges

  @@unique([systemId, partKey])
  @@map("hardware")
}

// ---- Colour / finish options (M5) ------------------------------------
// A selectable colour/finish that applies a percentage uplift to the
// VISIBLE profile lines (frame/sash/transom/bead) at pricing time.
// The base colour (e.g. white) carries 0% uplift, so a default catalog
// quote is byte-identical to pre-M5. Real foiled-colour uplifts are
// entered by the owner via the admin catalog API (never guessed).
model ColourOption {
  id       String        @id @default(uuid())
  systemId String
  system   ProfileSystem @relation(fields: [systemId], references: [id], onDelete: Cascade)

  key            String // in-memory Record key, e.g. "white"
  code           String // doc code, e.g. "COL-WHITE"
  name           String // e.g. "White" / "Golden Oak (Foiled)"
  costUpliftPct  Decimal @default(0) @db.Decimal(6, 3)
  priceUpliftPct Decimal @default(0) @db.Decimal(6, 3)
  isBase         Boolean @default(false)
  hex            String? // optional display swatch (CSS hex), e.g. "#353b3f"; null ⇒ grey preview

  @@unique([systemId, key])
  @@map("colour_option")
}

// ---- Cills (window sills) --------------------------------------------
// An external profile fitted below the frame. Selecting any cill reduces the
// manufacturing height by a fixed 30 mm (engine, solve.ts). `projectionMm` is
// the nominal size (95/150/180) and doubles as the SVG draw height. Priced per
// metre of product width. Cost/price/weight default to 0 (golden rule) until
// the owner fills them via the admin catalog CRUD / CSV import.
model Cill {
  id       String        @id @default(uuid())
  systemId String
  system   ProfileSystem @relation(fields: [systemId], references: [id], onDelete: Cascade)

  partKey           String // in-memory Record key, e.g. "cill-95-white"
  code              String // stock code, e.g. "GL-1-00095"
  name              String // e.g. "95mm Cill — White"
  projectionMm      Int // nominal size; also the SVG draw height
  cost              Decimal @default(0) @db.Decimal(12, 4)
  price             Decimal @default(0) @db.Decimal(12, 4)
  per               String  @default("m")
  weight            Decimal @default(0) @db.Decimal(12, 4)
  financialCategory String  @default("Glazing Accessories")

  @@unique([systemId, partKey])
  @@map("cill")
}

// ---- reinforcementMap: profile code -> reinforcement record key ------
model ReinforcementMapEntry {
  id       String        @id @default(uuid())
  systemId String
  system   ProfileSystem @relation(fields: [systemId], references: [id], onDelete: Cascade)

  profileCode      String // the .code of the profile being reinforced
  reinforcementKey String // the reinforcement Record key

  @@unique([systemId, profileCode])
  @@map("reinforcement_map")
}

// ---- Designs (cell-tree topology stored as JSONB) --------------------
// A design is "quotable" iff it has a CellNode topology the engine can solve.
// SVG-only designs imported from collections/ have topology=null, quotable=false;
// attaching a topology later (a data update) flips quotable=true with no code change.
model Design {
  designId    String  @id
  name        String
  productType String // "window" | "door"
  frameKey    String
  topology    Json? // recursive CellNode tree (null for SVG-only designs)
  svgPreview  String?

  // Catalogue / import metadata
  externalId        String? @unique // collections design UUID
  imageSvg          String? // embedded SVG from collections (large)
  quantityOfSquares Int?
  listIndex         Int?
  quotable          Boolean @default(false)

  // Per-design default manufacturing size (mm) — preloads the configurator and
  // sizes the gallery preview, replacing the old hardcoded 1200×1200. Null ⇒
  // caller falls back to a sensible default. Derived from the design's reference
  // work order (e.g. sliding-patio OX = 1500×1750).
  defaultWidthMm  Int?
  defaultHeightMm Int?

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  orderItems OrderItem[]

  @@index([productId])
  @@map("design")
}

// ---- Product (a product line, e.g. "Sunny Plast 70mm Casement") ------
model Product {
  id        String @id // collections product UUID
  name      String
  typeId    Int // NOT unique: e.g. Casement and Energy Plus Casement both share 101
  systemId  String
  listIndex Int    @default(0)

  designs    Design[]
  orderItems OrderItem[]

  @@index([typeId])
  @@map("product")
}

// =====================================================================
// RBAC (dynamic role & user management) — see docs/rbac/PLAN.md.
// Roles, permission actions, modules and the role×module×action grid are all
// DATA, not code. The only code-level special case is the Super Admin bypass,
// keyed off Role.scope == PLATFORM.
// =====================================================================

/// PLATFORM = Super Admin only (invisible/immutable to org actors). ORG = all else.
enum RoleScope {
  PLATFORM
  ORG
}

/// Row-level data scope carried by a permission grant. Each value maps to a
/// where-clause builder in code (OWN → {userId}, ALL → {}); ORG lands with tenancy.
enum PermissionDataScope {
  OWN
  ALL
}

/// Lifecycle state for a peer-approved Super Admin deletion request.
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXECUTED
}

/// A tenant. Created NOW with one seeded "default" org so org FKs exist from
/// day one; subdomain tenancy routing comes later (PLAN §9).
model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
  roles Role[]

  @@map("organization")
}

/// The dynamic module registry — one row per application module. navPath/navIcon/
/// sortOrder drive the sidebar; category groups modules in the role editor; a null
/// navPath = permission-only module (no nav). Source of truth: src/rbac/registry.ts.
model Module {
  id        String  @id @default(uuid())
  slug      String  @unique
  name      String
  navPath   String?
  navIcon   String?
  category  String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  permissions RolePermission[]

  @@map("module")
}

/// Permission actions as DATA (not an enum) so a new action is an INSERT.
/// Seeds: view, read, create, update, delete.
model PermissionAction {
  id        String @id @default(uuid())
  slug      String @unique
  name      String
  sortOrder Int    @default(0)

  permissions RolePermission[]

  @@map("permission_action")
}

model Role {
  id             String    @id @default(uuid())
  organizationId String? // null ⇒ platform-level role
  slug           String
  name           String
  description    String?
  scope          RoleScope @default(ORG)
  isSystem       Boolean   @default(false) // seed roles: undeletable, slug/scope immutable
  version        Int       @default(1) // bumped on grid change → permission-cache bust
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization?    @relation(fields: [organizationId], references: [id])
  permissions  RolePermission[]
  users        User[]

  @@unique([organizationId, slug])
  @@map("role")
}

/// One cell of the role × module × action grid, plus its data scope.
model RolePermission {
  id       String              @id @default(uuid())
  roleId   String
  moduleId String
  actionId String
  scope    PermissionDataScope @default(ALL)

  role   Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module Module           @relation(fields: [moduleId], references: [id])
  action PermissionAction @relation(fields: [actionId], references: [id])

  @@unique([roleId, moduleId, actionId])
  @@index([roleId])
  @@map("role_permission")
}

/// Append-only RBAC audit trail (written from the service layer in Phase 6).
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String? // who did it (null for system/seed)
  action     String // "user.deactivate", "role.permissions.update", …
  targetType String // "user" | "role"
  targetId   String?
  detail     Json? // before/after or grid diff
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorId, createdAt])
  @@map("audit_log")
}

// ---- Users (JWT auth) ------------------------------------------------
model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  phone        String?
  jobTitle     String?
  department   String?
  lastLoginAt  DateTime?

  // RBAC (PLAN §3.2). `roleId` is the single source of role truth (the legacy
  // free-form `role` string was dropped in Phase 6). Required now that every
  // user is backfilled; organizationId stays nullable until tenancy lands.
  roleId             String
  organizationId     String?
  isActive           Boolean @default(true)
  mustChangePassword Boolean @default(false)
  // Bumped on deactivate / role-change / password-reset → live JWTs rejected.
  tokenVersion       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  roleRef                  Role?                    @relation(fields: [roleId], references: [id])
  organization             Organization?            @relation(fields: [organizationId], references: [id])
  orders                   Order[]
  deletionRequestsIncoming AccountDeletionRequest[] @relation("deletionTarget")
  deletionRequestsOutgoing AccountDeletionRequest[] @relation("deletionRequester")

  @@index([roleId])
  @@map("user")
}

/// Append-only peer-consent workflow for deleting a platform Super Admin.
/// targetId becomes null after execution so the resolved row remains auditable.
model AccountDeletionRequest {
  id           String         @id @default(uuid())
  targetId     String?
  requesterId  String
  status       ApprovalStatus @default(PENDING)
  reason       String?
  createdAt    DateTime       @default(now())
  resolvedAt   DateTime?
  resolvedById String?

  target    User? @relation("deletionTarget", fields: [targetId], references: [id], onDelete: SetNull)
  requester User  @relation("deletionRequester", fields: [requesterId], references: [id])

  @@index([targetId, status])
  @@map("account_deletion_request")
}

// ---- Customers (minimal, B2B) ----------------------------------------
model Customer {
  id    String  @id @default(uuid())
  name  String
  email String?
  phone String?

  orders Order[]

  @@map("customer")
}

// ---- Orders ----------------------------------------------------------
model Order {
  id           String    @id @default(uuid())
  orderNo      String    @unique
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName String
  reference    String?
  status       String    @default("draft") // "draft" | "confirmed"
  // Grand total snapshot (M5) — set at confirm so the orders list can show a
  // price without re-solving. null for draft/legacy orders.
  totalPrice   Decimal?  @db.Decimal(12, 4)
  createdAt    DateTime  @default(now())

  items     OrderItem[]
  documents Document[]

  @@index([userId])
  @@map("order")
}

// ---- Order items (one fabricated unit = product + design + W×H) ------
model OrderItem {
  id               String  @id @default(uuid())
  orderId          String
  order            Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product @relation(fields: [productId], references: [id])
  designId         String
  design           Design  @relation(fields: [designId], references: [designId])
  systemId         String
  widthMm          Float
  heightMm         Float
  qty              Int     @default(1)
  mode             String  @default("default") // "default" | "custom"
  overrides        Json? // EngineOverrides when mode === "custom"
  splitRatios      Json? // per-quote span-drag overrides (Record<pathId, ratio>); null ⇒ default geometry
  frameKey         String? // per-quote chamber override (frame partKey, e.g. "frame-6ch"); null ⇒ design's baked frame
  cillKey          String? // selected cill Record key (null ⇒ no cill). Drives the 30mm deduction + cill render in confirmed docs.
  colourKeyInside  String? // per-quote inside/primary colour key; null ⇒ system default (byte-identical)
  colourKeyOutside String? // per-quote outside colour key (dual-colour finish); null ⇒ same as inside
  pricingSnapshot  Json? // totals captured at confirm

  @@index([orderId])
  @@map("order_item")
}

// ---- Generated documents (persisted at confirm) ----------------------
enum DocumentType {
  WORK_ORDER
  CUTTING_LIST
  BOM
  PRICE_SUMMARY
  WORK_PLANNER
  DMO
  PLANNER_LIST
}

model Document {
  id        String       @id @default(uuid())
  orderId   String
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      DocumentType
  // Cut-length variant: "normal" (finished sizes) or "welded" (sizes with weld
  // shrinkage compensation). Pricing docs only ever have "normal". @default keeps
  // existing rows as the normal variant after the migration.
  variant   String       @default("normal")
  html      String
  createdAt DateTime     @default(now())

  @@unique([orderId, type, variant])
  @@index([orderId])
  @@map("document")
}

// ---- Default financial / display settings (single row) ---------------
model Setting {
  id            Int     @id @default(1)
  currency      String
  taxApply      Boolean
  taxPct        Decimal @db.Decimal(6, 3)
  markupPct     Decimal @db.Decimal(6, 3)
  wastagePct    Decimal @db.Decimal(6, 3)
  labourPerSash Decimal @db.Decimal(12, 4)
  labourPerDoor Decimal @db.Decimal(12, 4)
  labourBase    Decimal @db.Decimal(12, 4)

  // Global welding-shrinkage allowance (mm per welded end) — the default for
  // every welded profile. A profile_part.weldAllowanceMm > 0 overrides it.
  weldAllowanceMm Decimal @default(2.5) @db.Decimal(10, 4)

  // Global company branding (M4) — printed on every document header.
  // logoKey is the object-storage key of the uploaded logo (resolved to an
  // embedded data-URI by the catalog loader); all nullable until configured.
  companyName    String?
  companyAddress String?
  accentColor    String?
  logoKey        String?

  @@map("setting")
}
